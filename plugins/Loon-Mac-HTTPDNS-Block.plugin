#!name = Mac HTTPDNS 拦截器
#!icon = https://raw.githubusercontent.com/hclchcl/loon-mac-httpdns-block/main/icon.png
#!desc = 阻止清单内 HTTPDNS 域名及常见 HTTP(S) 端口上的硬编码解析 IP，补充明文 HTTP 路径拦截。无需 PROXY 或 MitM；不保证所有应用都会回落系统 DNS。
#!author = hclchcl
#!homepage = https://github.com/hclchcl/loon-mac-httpdns-block
#!system = macOS
#!system_version = 13.0
#!date = 2026-10-28
#!tag = macOS,去广告
#!type = normal

# v1.0.1 | 目标：Loon for Mac 0.5.0 (1009)；待使用者实机测试。
# SPDX-License-Identifier: GPL-3.0-only
# 上游：VirgilClyne/GetSomeFries，详见 sources/manifest.json
# 适配修改：hclchcl，2026-10-28；署名与许可详见 plugins/NOTICE.md。
# 这是独立适配项目，不是可莉插件的复制品或官方 Mac 移植。
# 不含脚本、节点凭据、FINAL 或业务直连/代理策略。
# 本地放行规则、绕过 TUN 的流量及其他插件可能影响命中。
[Rule]
# IP 拦截限于 80/443/8080，不把解析服务器的所有端口一并封禁。
DOMAIN,httpdns.alicdn.com,REJECT
DOMAIN,httpdns-api.aliyuncs.com,REJECT
DOMAIN,httpdns-sc.aliyuncs.com,REJECT
DOMAIN,resolvers-cn.httpdns.aliyuncs.com,REJECT
AND,((OR,((DEST-PORT,80),(DEST-PORT,443),(DEST-PORT,8080))),(IP-CIDR,203.107.1.0/24,no-resolve)),REJECT
DOMAIN,httpsdns.baidu.com,REJECT
DOMAIN,httpdns.baidu.com,REJECT
AND,((OR,((DEST-PORT,80),(DEST-PORT,443),(DEST-PORT,8080))),(IP-CIDR,180.76.76.112/32,no-resolve)),REJECT
